---
import type { BookEntry } from "../lib/books/queries";
import { getCategoryLabel } from "../lib/books/categories";
import { getReadingTimeLabel } from "../lib/books/queries";
import BookCover from "./BookCover.astro";

interface Props {
  book: BookEntry;
}

const { book } = Astro.props;
const primaryCategory = book.data.categories[0]!;
const categoryLabel = getCategoryLabel(primaryCategory);
---

<article class="book-card">
  <a class="book-card__cover-link" href={`/books/${book.data.slug}/`} aria-label={`Buka ${book.data.title}`}>
    <BookCover
      title={book.data.title}
      category={categoryLabel}
      mock={book.data.mock}
      preview={book.data.preview}
      cover={book.data.storage.cover}
    />
  </a>
  <div class="book-card__meta">
    <h2><a href={`/books/${book.data.slug}/`}>{book.data.title}</a></h2>
    <p>{book.data.authors.join(", ")}</p>
    <div class="book-card__facts">
      <a href={`/category/${primaryCategory}/`}>{categoryLabel}</a>
      <span>{getReadingTimeLabel(book.data.reading.estimatedMinutes)}</span>
    </div>
  </div>
</article>

<style>
  /* Hallmark · component: book card · genre: editorial · theme: existing Newsprint
   * states: default · hover · focus · active · disabled
   */
  .book-card {
    min-width: 0;
  }

  .book-card__cover-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .book-card__meta {
    padding-block-start: var(--space-md);
  }

  .book-card h2 {
    margin-block-end: var(--space-xs);
    font-size: 1.25rem;
    line-height: 1.18;
  }

  .book-card h2 a {
    text-decoration: none;
  }

  .book-card p {
    margin-block-end: var(--space-sm);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .book-card__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    padding-block-start: var(--space-xs);
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .book-card__facts a {
    min-height: 1.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--color-accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .book-card__facts span {
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .book-card__cover-link:hover + .book-card__meta h2 a,
    .book-card h2 a:hover {
      color: var(--color-accent);
    }
  }
</style>
