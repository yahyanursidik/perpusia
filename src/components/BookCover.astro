---
import { getPublicAssetUrl } from "../lib/storage/public-url";

interface Props {
  title: string;
  category: string;
  mock?: boolean;
  preview?: boolean;
  cover?: string | undefined;
}

const { title, category, mock = false, preview = false, cover } = Astro.props;
const coverUrl = getPublicAssetUrl(cover);
---

<div class:list={["book-cover", { "book-cover--image": Boolean(coverUrl) }]} aria-hidden="true">
  {coverUrl ? (
    <img class="book-cover__image" src={coverUrl} alt="" loading="lazy" />
  ) : (
    <>
      <span class="book-cover__category">{category}</span>
      <strong>{title}</strong>
      <span class="book-cover__foot">{mock ? "Data demonstrasi" : "Perpustakaan Islam"}</span>
    </>
  )}
  {preview && <span class="book-cover__preview">Pratinjau</span>}
</div>

<style>
  /* Hallmark · component: book cover · genre: editorial · theme: existing Newsprint */
  .book-cover {
    position: relative;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: var(--space-lg);
    border: var(--rule-thin) solid var(--color-rule);
    background: var(--color-paper-deep);
    color: var(--color-ink);
  }

  .book-cover::before {
    content: "";
    width: var(--space-xl);
    border-block-start: var(--rule-thin) solid var(--color-accent);
  }

  .book-cover strong {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    font-weight: 500;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  .book-cover__category,
  .book-cover__foot,
  .book-cover__preview {
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  .book-cover__category {
    color: var(--color-accent);
    font-weight: 700;
  }

  .book-cover__foot {
    color: var(--color-ink-soft);
  }

  .book-cover__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-cover--image {
    overflow: hidden;
    padding: 0;
  }

  .book-cover--image::before {
    display: none;
  }

  .book-cover__preview {
    position: absolute;
    inset-inline-start: var(--space-sm);
    inset-block-end: var(--space-sm);
    padding: var(--space-3xs) var(--space-xs);
    background: var(--color-paper);
    color: var(--color-ink);
    font-weight: 700;
  }
</style>
